# ==============================================================================
# Smart Hotel IoT — Configuración Web (Outputs de CloudFormation: smart-hotel-iot-<env>)
# Copia este archivo a .env.local y reemplaza con los valores de tu stack AWS.
# ==============================================================================

# Entorno del stack: dev | qa | prod
VITE_ENV=dev

# Región AWS
VITE_AWS_REGION=us-east-1

# Cognito User Pool & Client (sin Client Secret, ALLOW_USER_SRP_AUTH)
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# Cognito Identity Pool (para credenciales temporales MQTT over WSS)
VITE_IDENTITY_POOL_ID=

# Base URL de HTTP API v2 (incluye stage /<env>, sin barra final)
# Ejemplo: https://abc123def.execute-api.us-east-1.amazonaws.com/dev
VITE_API_URL=

# IoT Data ATS Endpoint (aws iot describe-endpoint --endpoint-type iot:Data-ATS)
# Ejemplo: a1b2c3d4e5f6g7-ats.iot.us-east-1.amazonaws.com
VITE_IOT_ENDPOINT=

# Opcional: forzar modo demo local (true | false).
# Si los valores de AWS están vacíos, puedes entrar directamente en Modo Demo desde el login.
VITE_DEMO_MODE=false
